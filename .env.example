# Copy to .env and fill in. Never commit .env.

# --- Host values (see README, step 2) ---
VIDEO_GID=
RENDER_GID=
PUID=1000
PGID=1000

# --- Unsloth Studio ---
# UNSLOTH_IMAGE=unsloth/unsloth-rocm
# UNSLOTH_IMAGE_TAG=studio
# 11.0.0 maps the Radeon 780M (gfx1103) onto a supported target.
HSA_OVERRIDE_GFX_VERSION=11.0.0
UNSLOTH_STUDIO_PASSWORD=
JUPYTER_PASSWORD=
# Public key for root SSH login on port 2222; leave empty to keep SSH off.
SSH_KEY=
# HF_TOKEN=
# Set to 0.0.0.0 to reach Studio/Jupyter/SSH from the LAN.
# UNSLOTH_BIND=127.0.0.1

# --- Hermes Agent ---
HERMES_IMAGE_TAG=v0.22.5
# Set to 0.0.0.0 to reach the Hermes API and dashboards from the LAN.
# HERMES_BIND=127.0.0.1
# Dashboard and webapp login.
# HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# Bearer token for the OpenAI-compatible API on :8642 (min 8 chars).
API_SERVER_KEY=
API_SERVER_HOST=
# Studio API key (sk-unsloth-...), created in Studio under Settings > API.
UNSLOTH_API_KEY=

# --- agentgateway (reuses PUID/PGID and UNSLOTH_API_KEY) ---
# AGENTGATEWAY_IMAGE_TAG=v1.7.0
# Set to 0.0.0.0 to reach the gateway (:4000) and UI (:4001) from the LAN.
# AGENTGATEWAY_BIND=127.0.0.1

# Session token key: openssl rand -hex 32
AGENTGATEWAY_SESSION_KEY=

# GitHub Copilot token for the copilot/* models; must be accepted by the Copilot API.
GH_COPILOT_TOKEN=

# --- Telegram bot (optional) ---
# Get the bot token from @BotFather and your Telegram user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALLOWED_USERS=123456789
